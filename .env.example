# Use a separate high-entropy token (32+ characters). Do not commit .env.
IF_OPERATOR_KEY=REPLACE_WITH_LONG_RANDOM_OPERATOR_KEY
IF_DB_PATH=./data/invoiceflow.sqlite
IF_MAX_UPLOAD_BYTES=2097152
IF_MAX_PDF_PAGES=8

# AI extraction is off until explicitly opted into per upload.
# NEVER send confidential financial records without authorization.
IF_OPENAI_API_KEY=
IF_OPENAI_MODEL=gpt-4.1-mini
